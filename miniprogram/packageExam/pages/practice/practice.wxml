<!-- ================= 练习答题页 ================= -->
<view wx:if="{{screen === 'question'}}" class="exam-wrap-flex">
  <view class="exam-top" style="padding-top:calc({{statusBarHeight}}px + 24rpx);">
    <view class="exam-top-row" style="padding-right:{{menuGap}}px;">
      <view class="back-btn" bindtap="exitPractice">
        <image class="back-ico" src="{{icons.back}}" />
      </view>
      <view class="exam-name" style="margin-left:16rpx;">{{paperMeta.title}}</view>
      <view class="chapter-chip" bindtap="toggleSheet">
        <text>{{currentChapterBadge}}</text>
        <image src="{{icons.chevronDown}}" />
      </view>
    </view>
    <view class="exam-progress-row">
      <text class="exam-progress-label">{{currentChapterTitle}}</text>
      <text class="exam-progress-count">{{qIndex+1}} / {{chapterTotal}}</text>
    </view>
    <view class="exam-progress-track"><view class="exam-progress-fill" style="width:{{progressPct}}%"></view></view>
  </view>

  <scroll-view class="exam-scroll" scroll-y="true">
    <view class="q-card">
      <view wx:if="{{answered}}" class="rev-tag {{picked === currentQuestion.answer ? 'correct' : 'wrong'}}">
        {{picked === currentQuestion.answer ? '✔ 回答正确' : '✕ 回答错误'}}
      </view>
      <view class="q-stem">{{currentQuestion.displayStem}}</view>
      <view class="options">
        <view
          wx:for="{{letters}}"
          wx:key="*this"
          class="option {{answered ? (item === currentQuestion.answer ? 'rev-correct' : (item === picked ? 'rev-wrong' : 'rev-dim')) : ''}}"
          data-letter="{{item}}"
          bindtap="pickAnswer"
        >
          <view class="option-letter">{{item}}</view>
          <view class="option-text">{{currentQuestion.options[item]}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{answered && currentQuestion.explanation}}" class="explain">
      <view class="explain-head">
        <view class="explain-icon"><image src="{{icons.bulb}}" /></view>
        <text class="explain-label">解析</text>
      </view>
      <view class="explain-text">{{currentQuestion.explanation}}</view>
    </view>
  </scroll-view>

  <view class="exam-footer">
    <view class="nav-btn {{qIndex === 0 ? 'disabled' : ''}}" bindtap="prevQuestion">
      <image src="{{icons.back}}" /><text>上一题</text>
    </view>
    <view class="grid-btn" bindtap="toggleNavigator">
      <image src="{{icons.listDark}}" /><text>题号导航</text>
    </view>
    <view class="nav-btn" bindtap="nextQuestion">
      <text>{{qIndex + 1 === chapterTotal ? '完成本章' : '下一题'}}</text>
      <image src="{{icons.next}}" />
    </view>
  </view>
</view>

<!-- ================= 本章完成页 ================= -->
<view wx:elif="{{screen === 'done'}}" class="result-wrap" style="padding-top:calc({{statusBarHeight}}px + 52rpx);">
  <view class="result-title">{{currentChapterBadge}}练习完成</view>
  <view class="result-desc">{{currentChapterTitle}} · 共 {{chapterTotal}} 题</view>
  <view class="result-actions">
    <button class="result-btn primary" bindtap="restartChapter">重新练习本章</button>
    <button class="result-btn ghost" bindtap="toggleSheet">切换章节</button>
    <button class="result-btn text" bindtap="exitPractice">返回首页</button>
  </view>
</view>

<!-- ================= 章节切换面板 ================= -->
<view class="sheet-overlay {{sheetVisible ? 'show' : ''}}" bindtap="closeSheet"></view>
<view class="sheet {{sheetVisible ? 'show' : ''}}">
  <view class="sheet-handle"></view>
  <view class="sheet-title-row"><text class="sheet-title">切换章节</text></view>
  <view class="sheet-list">
    <view
      wx:for="{{chapters}}"
      wx:key="chapter"
      class="sheet-item {{index === chapterIdx ? 'selected' : ''}}"
      data-index="{{index}}"
      bindtap="switchChapter"
    >
      <view class="sheet-item-left">
        <view class="sheet-badge">{{item.badgeLabel}}</view>
        <view>
          <view class="sheet-item-title">{{item.title}}</view>
          <view class="sheet-item-sub">{{item.items.length}} 题</view>
        </view>
      </view>
      <image wx:if="{{index === chapterIdx}}" class="sheet-check" src="{{icons.check}}" />
    </view>
  </view>
  <view class="sheet-cancel" bindtap="closeSheet">取消</view>
</view>

<!-- ================= 题号导航面板（本章内，答对/答错/未答三色） ================= -->
<view class="sheet-overlay {{navVisible ? 'show' : ''}}" bindtap="closeNavigator"></view>
<view class="sheet {{navVisible ? 'show' : ''}}">
  <view class="sheet-handle"></view>
  <view class="sheet-title-row">
    <text class="sheet-title">题号导航</text>
    <view class="legend">
      <view class="legend-item"><view class="legend-dot" style="background:linear-gradient(140deg,#0B6B63,#17C9A3)"></view>正确</view>
      <view class="legend-item"><view class="legend-dot" style="background:#E2604B"></view>错误</view>
      <view class="legend-item"><view class="legend-dot" style="background:#F1F3F7;border:1rpx solid rgba(20,24,33,0.07)"></view>未答</view>
    </view>
  </view>
  <view class="qgrid">
    <view
      wx:for="{{navCells}}"
      wx:key="index"
      class="qcell {{item.state === 'correct' ? 'rev-correct' : ''}} {{item.state === 'wrong' ? 'rev-wrong' : ''}} {{item.state === 'blank' ? 'rev-blank' : ''}} {{item.current ? 'current' : ''}}"
      data-index="{{item.index}}"
      bindtap="onNavCellTap"
    >{{item.num}}</view>
  </view>
</view>

<!-- ================= 断点续练提示 ================= -->
<view class="confirm-overlay {{resumePromptVisible ? 'show' : ''}}">
  <view class="confirm-box">
    <view class="confirm-title">继续上次的进度？</view>
    <view class="confirm-text">检测到你上次做到{{resumeChapterLabel}}，是否继续上次的进度？</view>
    <view class="confirm-actions">
      <button class="confirm-btn primary" bindtap="resumeContinue">继续上次</button>
      <button class="confirm-btn ghost" bindtap="resumeRestart">重新开始</button>
    </view>
  </view>
</view>
