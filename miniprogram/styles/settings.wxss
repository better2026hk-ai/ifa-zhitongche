/* "我的"页设置分组——账号管理/意见反馈/关于我们/退出登录都是这个样式 */

.settings-group {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 28rpx -16rpx rgba(20, 24, 33, 0.08);
}

.settings-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(20, 24, 33, 0.06);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-ico {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.settings-ico image {
  width: 32rpx;
  height: 32rpx;
}

.settings-label {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-0);
  font-weight: 500;
}

.settings-label.danger {
  color: var(--coral);
}

.settings-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 账号管理页：只读的"标签 + 值"行，复用同一个 settings-group 容器 */
.account-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(20, 24, 33, 0.06);
}

.account-row:last-child {
  border-bottom: none;
}

.account-label {
  width: 176rpx;
  font-size: 27rpx;
  color: var(--text-1);
  flex-shrink: 0;
}

.account-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-0);
}
