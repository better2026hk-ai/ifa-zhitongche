/* 错题本详情/选题/测验完成用到的样式，q-card/options/rev-tag/explain/
   exam-top/exam-footer 复用 styles/exam.wxss 那一套。 */

.select-footer {
  flex-shrink: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.select-all-btn {
  font-weight: 600;
  font-size: 25rpx;
  color: var(--green);
  background: rgba(11, 107, 99, 0.08);
  border: 1rpx solid rgba(11, 107, 99, 0.2);
  border-radius: 24rpx;
  padding: 0 28rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
}

.wide-btn {
  width: 100%;
  text-align: center;
  padding: 28rpx;
  border-radius: 30rpx;
  border: none;
  font-weight: 700;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(120deg, var(--green), var(--green-bright));
  box-shadow: 0 20rpx 44rpx -20rpx rgba(11, 107, 99, 0.5);
}

.wide-btn[disabled] {
  opacity: 0.4;
}

.check-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-circle.checked {
  background: linear-gradient(140deg, var(--green), var(--green-bright));
  border-color: transparent;
}

.check-circle image {
  width: 24rpx;
  height: 24rpx;
}

.wrong-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx -16rpx rgba(20, 24, 33, 0.08);
}

.wrong-card-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
}

.wrong-card-title {
  font-weight: 600;
  font-size: 27rpx;
  color: var(--text-0);
  line-height: 1.4;
}

.wrong-card-sub {
  font-size: 22rpx;
  color: var(--text-1);
  margin-top: 6rpx;
}

.wrong-card-toggle {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.wrong-card-toggle.open {
  transform: rotate(180deg);
}

.wrong-card-detail {
  padding: 0 28rpx 32rpx;
  border-top: 1rpx solid rgba(20, 24, 33, 0.06);
  padding-top: 28rpx;
}
