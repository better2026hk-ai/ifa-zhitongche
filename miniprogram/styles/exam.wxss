/* 模拟考试规则页 + 答题页 + 出分页 + 复盘页共用样式；
   错题本测验页也复用了这里的 q-card/options/explain/exam-top 系列。 */

.start-wrap {
  height: 100vh;
  padding: calc(20rpx + max(24px, env(safe-area-inset-top))) 44rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.start-back-row {
  margin-bottom: 12rpx;
}

/* 答题页/复盘页：顶部固定 + 中间滚动 + 底部固定的整屏三段式布局 */
.exam-wrap-flex {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.exam-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.start-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green);
  background: rgba(11, 107, 99, 0.08);
  border: 1rpx solid rgba(11, 107, 99, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 18rpx;
  width: fit-content;
  margin-bottom: 28rpx;
}

.start-title {
  font-weight: 800;
  font-size: 48rpx;
  letter-spacing: -0.6rpx;
  line-height: 1.3;
  margin-bottom: 16rpx;
  color: var(--text-0);
}

.start-desc {
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.6;
  margin-bottom: 44rpx;
}

.rule-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 48rpx -28rpx rgba(20, 24, 33, 0.14);
  margin-bottom: 28rpx;
}

.rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(20, 24, 33, 0.06);
}

.rule-row:last-child {
  border-bottom: none;
}

.rule-label {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 26rpx;
  color: var(--text-1);
}

.rule-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rule-ico image {
  width: 30rpx;
  height: 30rpx;
}

.rule-value {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-0);
}

.spacer {
  flex: 1;
}

.start-btn {
  width: 100%;
  text-align: center;
  padding: 32rpx;
  border-radius: 34rpx;
  border: none;
  font-weight: 700;
  font-size: 31rpx;
  color: #fff;
  background: linear-gradient(120deg, var(--green), var(--green-bright));
  box-shadow: 0 28rpx 56rpx -24rpx rgba(11, 107, 99, 0.55);
}

.start-btn:active {
  opacity: 0.9;
}

/* ---- 答题页顶部：题目名/倒计时/交卷 + 进度条 ---- */

.exam-top {
  flex-shrink: 0;
  padding: calc(24rpx + max(24px, env(safe-area-inset-top))) 40rpx 20rpx;
  box-sizing: border-box;
}

.exam-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.exam-name {
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-0);
}

.top-right-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.submit-mini-btn {
  font-weight: 700;
  font-size: 25rpx;
  color: #fff;
  background: linear-gradient(120deg, var(--coral), #EF7B62);
  padding: 16rpx 26rpx;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 28rpx -12rpx rgba(226, 96, 75, 0.5);
}

.timer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-weight: 700;
  font-size: 28rpx;
  color: var(--text-0);
  background: var(--surface);
  border: 1rpx solid var(--border);
  padding: 12rpx 22rpx;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 16rpx -8rpx rgba(20, 24, 33, 0.08);
}

.timer.warn {
  color: var(--coral);
  border-color: rgba(226, 96, 75, 0.4);
  background: var(--coral-tint);
}

.timer image {
  width: 26rpx;
  height: 26rpx;
}

/* 练习模式顶栏的"第 X 章"胶囊按钮 */
.chapter-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  padding: 16rpx 22rpx;
  box-shadow: 0 4rpx 16rpx -8rpx rgba(20, 24, 33, 0.08);
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-weight: 700;
  font-size: 24rpx;
  color: var(--green);
  white-space: nowrap;
  flex-shrink: 0;
}

.chapter-chip image {
  width: 24rpx;
  height: 24rpx;
}

.exam-progress-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.exam-progress-label {
  font-size: 23rpx;
  color: var(--text-1);
}

.exam-progress-count {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-0);
}

.exam-progress-track {
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(20, 24, 33, 0.08);
  overflow: hidden;
}

.exam-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--green), var(--green-bright));
  transition: width 0.3s ease;
}

/* ---- 题卡 + 选项 ---- */

.q-card {
  background: linear-gradient(180deg, #FFFFFF, #FAFBFD);
  border: 1rpx solid var(--border);
  border-radius: 44rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 16rpx 52rpx -24rpx rgba(20, 24, 33, 0.12);
}

.q-stem {
  font-weight: 600;
  font-size: 31rpx;
  line-height: 1.6;
  color: var(--text-0);
  white-space: pre-line;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 32rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 30rpx;
  padding: 24rpx 26rpx;
}

.option-letter {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-weight: 700;
  font-size: 24rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  color: var(--text-1);
}

.option-text {
  font-size: 27rpx;
  color: var(--text-0);
  line-height: 1.45;
}

.option.picked {
  border-color: rgba(11, 107, 99, 0.55);
  background: linear-gradient(120deg, rgba(23, 201, 163, 0.1), rgba(23, 201, 163, 0.02));
}

.option.picked .option-letter {
  background: linear-gradient(140deg, var(--green), var(--green-bright));
  color: #fff;
  border-color: transparent;
}

.option.rev-correct {
  border-color: rgba(11, 107, 99, 0.55);
  background: linear-gradient(120deg, rgba(23, 201, 163, 0.1), rgba(23, 201, 163, 0.02));
}

.option.rev-correct .option-letter {
  background: linear-gradient(140deg, var(--green), var(--green-bright));
  color: #fff;
  border-color: transparent;
}

.option.rev-wrong {
  border-color: rgba(226, 96, 75, 0.5);
  background: linear-gradient(120deg, rgba(226, 96, 75, 0.1), rgba(226, 96, 75, 0.02));
}

.option.rev-wrong .option-letter {
  background: var(--coral);
  color: #fff;
  border-color: transparent;
}

.option.rev-dim {
  opacity: 0.5;
}

.rev-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.rev-tag.correct {
  color: var(--green);
  background: rgba(11, 107, 99, 0.08);
  border: 1rpx solid rgba(11, 107, 99, 0.2);
}

.rev-tag.wrong {
  color: var(--coral);
  background: var(--coral-tint);
  border: 1rpx solid rgba(226, 96, 75, 0.25);
}

.rev-tag.blank {
  color: var(--text-2);
  background: var(--surface-2);
  border: 1rpx solid var(--border);
}

.explain {
  margin-top: 28rpx;
  padding: 32rpx 32rpx 32rpx 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(120deg, rgba(23, 201, 163, 0.07), rgba(23, 201, 163, 0.02));
  border: 1rpx solid rgba(11, 107, 99, 0.16);
  border-left: 8rpx solid var(--green);
  box-shadow: 0 12rpx 36rpx -24rpx rgba(11, 107, 99, 0.25);
}

.explain-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.explain-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: linear-gradient(140deg, var(--green), var(--green-bright));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx -6rpx rgba(11, 107, 99, 0.5);
}

.explain-icon image {
  width: 24rpx;
  height: 24rpx;
}

.explain-label {
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  color: var(--green);
}

.explain-text {
  font-size: 26rpx;
  color: var(--text-0);
  line-height: 1.7;
  opacity: 0.85;
}

/* ---- 底部导航条：上一题/题号导航/下一题 ---- */

.exam-footer {
  flex-shrink: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.nav-btn {
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 10rpx;
  justify-content: center;
  color: var(--text-0);
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx -8rpx rgba(20, 24, 33, 0.08);
  font-weight: 700;
  font-size: 25rpx;
  white-space: nowrap;
}

.nav-btn.disabled {
  opacity: 0.35;
}

.nav-btn image {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.grid-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-shadow: 0 4rpx 16rpx -8rpx rgba(20, 24, 33, 0.08);
  font-weight: 700;
  font-size: 25rpx;
  color: var(--text-0);
  white-space: nowrap;
  overflow: hidden;
  min-width: 0;
}

.grid-btn image {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* ---- 题号导航面板 ---- */

.qgrid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.qcell {
  aspect-ratio: 1;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-weight: 700;
  font-size: 24rpx;
  background: var(--surface-2);
  border: 3rpx solid var(--border);
  color: var(--text-1);
  position: relative;
}

.qcell.answered {
  background: linear-gradient(140deg, var(--green), var(--green-bright));
  color: #fff;
  border-color: transparent;
}

.qcell.current {
  border-color: var(--green);
  box-shadow: 0 0 0 8rpx rgba(11, 107, 99, 0.16);
}

.qcell.rev-correct {
  background: linear-gradient(140deg, var(--green), var(--green-bright));
  color: #fff;
  border-color: transparent;
}

.qcell.rev-wrong {
  background: var(--coral);
  color: #fff;
  border-color: transparent;
}

.qcell.rev-blank {
  background: var(--surface-2);
  color: var(--text-2);
  border-color: var(--border);
}

.legend {
  display: flex;
  gap: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: var(--text-1);
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

/* ---- 出分页 ---- */

.result-wrap {
  height: 100vh;
  box-sizing: border-box;
  padding: calc(52rpx + max(24px, env(safe-area-inset-top))) 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow-y: auto;
}

.result-pass-badge {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  margin-bottom: 36rpx;
}

.result-pass-badge.pass {
  background: rgba(11, 107, 99, 0.1);
  color: var(--green);
  border: 1rpx solid rgba(11, 107, 99, 0.25);
}

.result-pass-badge.fail {
  background: var(--coral-tint);
  color: var(--coral);
  border: 1rpx solid rgba(226, 96, 75, 0.25);
}

.result-ring {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  position: relative;
  margin-bottom: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-ring-inner {
  width: 296rpx;
  height: 296rpx;
  border-radius: 50%;
  background: var(--bg-1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-pct {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: var(--text-0);
}

.result-frac {
  font-size: 24rpx;
  color: var(--text-1);
  margin-top: 4rpx;
  font-family: "JetBrains Mono", "SF Mono", monospace;
}

.result-title {
  font-weight: 800;
  font-size: 38rpx;
  margin-bottom: 12rpx;
  color: var(--text-0);
}

.result-desc {
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.6;
  margin-bottom: 52rpx;
  max-width: 560rpx;
}

.result-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  width: 100%;
  margin-bottom: 52rpx;
}

.rstat-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 30rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 8rpx 28rpx -16rpx rgba(20, 24, 33, 0.08);
}

.rstat-num {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 32rpx;
  font-weight: 700;
}

.rstat-label {
  font-size: 20rpx;
  color: var(--text-1);
  margin-top: 6rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.result-btn {
  width: 100%;
  text-align: center;
  padding: 28rpx;
  border-radius: 30rpx;
  border: none;
  font-weight: 700;
  font-size: 28rpx;
}

.result-btn.primary {
  color: #fff;
  background: linear-gradient(120deg, var(--green), var(--green-bright));
  box-shadow: 0 20rpx 44rpx -20rpx rgba(11, 107, 99, 0.5);
}

.result-btn.ghost {
  color: var(--text-1);
  background: var(--surface-2);
  border: 1rpx solid var(--border);
}

.result-btn.text {
  background: none;
  color: var(--text-2);
  box-shadow: none;
  padding: 12rpx;
  font-size: 25rpx;
}
