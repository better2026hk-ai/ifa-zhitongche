.placeholder-wrap {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: max(24px, env(safe-area-inset-top)) 80rpx 200rpx;
  text-align: center;
}

.placeholder-ico {
  width: 112rpx;
  height: 112rpx;
  border-radius: 36rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-ico image {
  width: 52rpx;
  height: 52rpx;
}

.placeholder-title {
  font-weight: 700;
  font-size: 31rpx;
  color: var(--text-0);
}

.placeholder-desc {
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.6;
}

.placeholder-btn {
  margin-top: 4rpx;
  padding: 22rpx 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, var(--green), var(--green-bright));
  color: #fff;
  font-weight: 700;
  font-size: 27rpx;
  box-shadow: 0 20rpx 44rpx -14rpx rgba(11, 107, 99, 0.55);
}
