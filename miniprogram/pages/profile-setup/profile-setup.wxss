@import "../../styles/shared.wxss";

.avatar-picker {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: var(--surface-2);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  margin-bottom: 20rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 56rpx;
  color: var(--text-2);
  font-weight: 300;
}

.avatar-hint {
  font-size: 23rpx;
  color: var(--text-2);
  margin-bottom: 56rpx;
}

.field {
  width: 100%;
  max-width: 560rpx;
  text-align: left;
  margin-bottom: 16rpx;
}

.field-label {
  font-weight: 700;
  font-size: 28rpx;
  color: var(--text-0);
  margin-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 92rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-0);
  box-sizing: border-box;
}

.confirm-btn {
  margin-top: 44rpx;
}
