@import "../../styles/shared.wxss";

.review-top {
  flex-shrink: 0;
  padding: 28rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.review-title {
  font-weight: 700;
  font-size: 30rpx;
  color: var(--text-0);
}

.exam-content {
  height: calc(100vh - 120rpx);
  padding: 16rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.policy-updated {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 36rpx;
}

.policy-h2 {
  font-weight: 700;
  font-size: 29rpx;
  color: var(--green);
  margin: 44rpx 0 16rpx;
}

.policy-p {
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.7;
  margin-bottom: 12rpx;
  display: block;
}

.policy-p.intro {
  color: var(--text-0);
}

.policy-footnote {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-top: 44rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border);
}
