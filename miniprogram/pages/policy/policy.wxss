@import "../../styles/shared.wxss";

.policy-updated {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 36rpx;
}

.policy-h2 {
  font-weight: 700;
  font-size: 29rpx;
  color: var(--green);
  margin: 44rpx 0 16rpx;
}

.policy-p {
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.7;
  margin-bottom: 12rpx;
  display: block;
}

.policy-p.intro {
  color: var(--text-0);
}

.policy-footnote {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-top: 44rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border);
}
