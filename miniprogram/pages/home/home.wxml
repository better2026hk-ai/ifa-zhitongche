<scroll-view class="home-scroll" scroll-y="true">
  <view class="topbar">
    <view class="brand">
      <image class="brand-mark" src="/images/app-icon.png" mode="aspectFill" />
      <text class="brand-name">IFA直通车</text>
    </view>
    <view class="avatar" bindtap="goProfile">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else>👤</text>
    </view>
  </view>

  <view class="greeting">
    Hey，{{nickname}}
    <text class="greeting-sub">备考第 {{days}} 天</text>
  </view>

  <view class="selector" bindtap="openSheet">
    <view class="selector-left">
      <view class="selector-tag">{{current.tag}}</view>
      <view class="selector-text">
        <view class="selector-title">{{current.title}}</view>
        <view class="selector-sub">{{current.done}} / {{current.total}} 题已练习</view>
      </view>
    </view>
    <image class="chevron" src="{{chevronIcon}}" />
  </view>

  <view class="dashboard">
    <view class="dash-row">
      <view class="ring-outer" style="background:conic-gradient(var(--green) 0%, var(--green-bright) {{current.pct}}%, rgba(20,24,33,0.08) {{current.pct}}% 100%);">
        <view class="ring-inner">
          <view class="ring-pct">{{current.pct}}%</view>
          <view class="ring-label">掌握度</view>
        </view>
      </view>
      <view class="dash-info">
        <view class="dash-info-title">{{current.tag}} · {{current.title}}</view>
        <view class="dash-info-desc">{{current.desc}}</view>
        <button class="cta" bindtap="onContinue">
          继续练习
          <image class="cta-arrow" src="{{arrowIcon}}" />
        </button>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">我的题库</text>
    <text class="section-count">5 个考试科目</text>
  </view>

  <view class="paper-list">
    <view
      wx:for="{{banks}}"
      wx:key="key"
      class="paper-card {{item.key === current.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelectBank"
    >
      <view class="paper-icon">{{item.tag}}</view>
      <view class="paper-mid">
        <view class="paper-title">{{item.title}}</view>
        <view class="paper-sub">{{item.total}} 题 · 正确率 {{item.acc}}%</view>
        <view class="paper-progress"><view class="paper-progress-fill" style="width:{{item.pct}}%"></view></view>
      </view>
      <view class="paper-right">
        <view class="paper-frac">{{item.done}}/{{item.total}}</view>
        <text class="paper-arrow">›</text>
      </view>
    </view>
  </view>

  <view style="height:200rpx;"></view>
</scroll-view>

<view class="sheet-overlay {{sheetVisible ? 'show' : ''}}" bindtap="closeSheet"></view>
<view class="sheet {{sheetVisible ? 'show' : ''}}">
  <view class="sheet-handle"></view>
  <view class="sheet-title-row"><text class="sheet-title">切换题库</text></view>
  <view class="sheet-list">
    <view
      wx:for="{{banks}}"
      wx:key="key"
      class="sheet-item {{item.key === current.key ? 'selected' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelectBank"
    >
      <view class="sheet-item-left">
        <view class="sheet-badge">{{item.tag}}</view>
        <view>
          <view class="sheet-item-title">{{item.title}}</view>
          <view class="sheet-item-sub">{{item.done}}/{{item.total}} 题 · 正确率 {{item.acc}}%</view>
        </view>
      </view>
      <image wx:if="{{item.key === current.key}}" class="sheet-check" src="{{checkIcon}}" />
    </view>
  </view>
  <view class="sheet-cancel" bindtap="closeSheet">取消</view>
</view>
