<scroll-view class="home-scroll" scroll-y="true" style="padding-top:calc({{statusBarHeight}}px + 12rpx);">
  <block wx:if="{{loggedIn}}">
    <view class="profile-header" style="padding-right:{{menuGap}}px;">
      <view class="profile-avatar-lg">
        <image wx:if="{{avatarUrl}}" class="profile-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <text wx:else>👤</text>
      </view>
      <view class="profile-header-text">
        <view class="profile-name">{{nickname}}</view>
        <view class="profile-sub">备考第 {{days}} 天 · IFA直通车</view>
      </view>
      <view class="profile-edit" bindtap="editProfile">
        <image src="{{editIcon}}" />
      </view>
    </view>

    <view class="section-head" style="margin-top:0;">
      <text class="section-title">学习总览</text>
    </view>
    <view class="overview-grid">
      <view class="stat-card"><view class="stat-num">{{overview.totalPracticed}}</view><view class="stat-label">已练习题数</view></view>
      <view class="stat-card"><view class="stat-num up">{{overview.avgAcc}}%</view><view class="stat-label">平均正确率</view></view>
      <view class="stat-card"><view class="stat-num">{{overview.streak}}</view><view class="stat-label">连续打卡天数</view></view>
      <view class="stat-card"><view class="stat-num">{{overview.examCount}}</view><view class="stat-label">模考次数</view></view>
      <view class="stat-card"><view class="stat-num up">{{overview.passCount}}</view><view class="stat-label">模考通过</view></view>
      <view class="stat-card"><view class="stat-num" style="color:var(--coral)">{{overview.wrongCount}}</view><view class="stat-label">当前错题</view></view>
    </view>

    <view class="section-head">
      <text class="section-title">模拟考试记录</text>
      <text class="section-count">{{overview.examCount}} 次</text>
    </view>
    <view wx:if="{{overview.examCount === 0}}" class="empty-note">
      <text class="placeholder-desc">还没有模拟考试记录，去挑战一次试试吧。</text>
    </view>
    <block wx:else>
      <view
        wx:for="{{historyPreview}}"
        wx:key="index"
        class="history-card"
        data-index="{{index}}"
        bindtap="onOpenHistory"
      >
        <view class="paper-icon">{{item.paperTag}}</view>
        <view class="history-mid">
          <view class="history-title">{{item.paperName}}</view>
          <view class="history-sub">{{item.dateStr}}</view>
        </view>
        <view class="history-score">
          <view class="history-pct" style="color:{{item.passed ? 'var(--green)' : 'var(--coral)'}}">{{item.pct}}%</view>
          <view class="history-badge {{item.passed ? 'pass' : 'fail'}}">{{item.passed ? 'PASS' : 'FAIL'}}</view>
        </view>
      </view>
      <view wx:if="{{overview.examCount > 3}}" class="history-more" bindtap="openExamHistoryList">
        查看历史记录（近 {{historyCountLabel}} 次）
      </view>
    </block>

    <view class="section-head">
      <text class="section-title">设置</text>
    </view>
    <view class="settings-group">
      <view class="settings-row" bindtap="openAccount">
        <view class="settings-ico"><image src="{{icons.user}}" /></view>
        <text class="settings-label">账号管理</text>
        <image class="settings-arrow" src="{{arrowIcon}}" />
      </view>
      <view class="settings-row" bindtap="openFeedback">
        <view class="settings-ico"><image src="{{icons.message}}" /></view>
        <text class="settings-label">意见反馈</text>
        <image class="settings-arrow" src="{{arrowIcon}}" />
      </view>
      <view class="settings-row" bindtap="openAbout">
        <view class="settings-ico"><image src="{{icons.info}}" /></view>
        <text class="settings-label">关于我们</text>
        <image class="settings-arrow" src="{{arrowIcon}}" />
      </view>
    </view>
    <view class="settings-group">
      <view class="settings-row" bindtap="handleLogout">
        <view class="settings-ico danger"><image src="{{logoutIcon}}" /></view>
        <text class="settings-label danger">退出登录</text>
        <image class="settings-arrow" src="{{arrowIcon}}" />
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="placeholder-wrap" style="height:auto; padding-top:120rpx; padding-bottom:80rpx;">
      <view class="profile-avatar-lg"><text>👤</text></view>
      <view class="placeholder-title">还没有登录</view>
      <view class="placeholder-desc">登录后可以查看你的学习总览、模拟考试记录，以及管理账号资料。</view>
      <button class="placeholder-btn" bindtap="goLogin">微信登录</button>
    </view>

    <view class="section-head" style="margin-top:0;">
      <text class="section-title">设置</text>
    </view>
    <view class="settings-group">
      <view class="settings-row" bindtap="openAbout">
        <view class="settings-ico"><image src="{{icons.info}}" /></view>
        <text class="settings-label">关于我们</text>
        <image class="settings-arrow" src="{{arrowIcon}}" />
      </view>
    </view>
  </block>

  <view style="height:200rpx;"></view>
</scroll-view>

<view class="confirm-overlay {{confirmVisible ? 'show' : ''}}">
  <view class="confirm-box">
    <view class="confirm-title">退出登录</view>
    <view class="confirm-text">确定要退出登录吗？退出后需要重新完成微信授权才能继续使用。</view>
    <view class="confirm-actions">
      <button class="confirm-btn danger" bindtap="confirmLogout">退出登录</button>
      <button class="confirm-btn ghost" bindtap="cancelLogout">取消</button>
    </view>
  </view>
</view>
