@import "../../styles/confirm.wxss";
@import "../../styles/history.wxss";
@import "../../styles/list.wxss";
@import "../../styles/profile-header.wxss";
@import "../../styles/settings.wxss";
@import "../../styles/placeholder.wxss";

.profile-edit {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx -8rpx rgba(20, 24, 33, 0.08);
  flex-shrink: 0;
}

.profile-edit image {
  width: 30rpx;
  height: 30rpx;
}

.empty-note {
  padding: 8rpx 4rpx 0;
}

.placeholder-desc {
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.6;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.stat-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 8rpx 28rpx -16rpx rgba(20, 24, 33, 0.1);
}

.stat-num {
  font-family: "JetBrains Mono", "SF Mono", monospace;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-0);
}

.stat-num.up {
  color: var(--up);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-1);
  margin-top: 8rpx;
}
