<scroll-view class="home-scroll" scroll-y="true" style="padding-top:calc({{statusBarHeight}}px + 12rpx);">
  <image class="hero-banner" src="/images/exam-list-banner.jpg" mode="widthFix" />
  <view class="banner-stats">
    <view class="banner-stat">{{paperCount}} 门可用</view>
    <view class="banner-stat">{{totalQuestions}} 道真题</view>
  </view>
  <view class="paper-list">
    <view
      wx:for="{{papers}}"
      wx:key="key"
      class="paper-card"
      data-key="{{item.key}}"
      bindtap="onSelectExam"
    >
      <view class="paper-icon">{{item.tag}}</view>
      <view class="paper-mid">
        <view class="paper-title">{{item.title}}</view>
        <view class="paper-sub">{{item.totalQuestions}} 题 · {{item.durationMinutes}} 分钟 · 合格 {{item.passCount}} 题</view>
      </view>
      <view class="paper-right"><text class="paper-arrow">›</text></view>
    </view>
  </view>
  <view style="height:200rpx;"></view>
</scroll-view>

<view class="confirm-overlay {{loginPromptVisible ? 'show' : ''}}">
  <view class="confirm-box">
    <view class="confirm-title">需要登录</view>
    <view class="confirm-text">模拟考试要登录后才能开考（成绩要跟你的账号绑定），是否前往登录？</view>
    <view class="confirm-actions">
      <button class="confirm-btn primary" bindtap="goLogin">去登录</button>
      <button class="confirm-btn ghost" bindtap="closeLoginPrompt">取消</button>
    </view>
  </view>
</view>
